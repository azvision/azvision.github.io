---
import { Image } from 'astro:assets';
import logo from '../assets/logo_light.png';
import Layout from '../layouts/Layout.astro';
import ProductCard from '../components/ProductCard.astro';
import ContactSection from '../components/ContactSection.astro';
---

<Layout
  title="AZ Vision | AI řešení pro retail a veřejnou správu"
  description="AZ Vision vyvíjí praktická AI řešení: počítání návštěvníků (Footfall), hlasovou AI prodavačku a hlídání zmínek o nemovitostech v jednáních zastupitelstev."
  keywords="AZ Vision, počítání návštěvníků, footfall, AI prodavačka, hlasový asistent, hlídání zastupitelstev, nemovitosti, počítačové vidění, umělá inteligence"
  canonicalUrl="https://www.azvision.cz/"
  ogImage="https://www.azvision.cz/footfall-preview.jpg"
  lang="cs"
  ogLocale="cs_CZ"
  hasEn={true}
  csHref="/"
  enHref="/en/"
  serviceType="AI solutions"
>
  <main>
    <section class="hero">
      <Image src={logo} alt="AZ Vision logo" class="logo-img" width={234} height={180} densities={[1, 2]} format="webp" loading="eager" fetchpriority="high" />
      <h1>Chytrá AI řešení od AZ Vision</h1>
      <p class="hero-subtitle">Jsme čeští vývojáři neuronových sítí a počítačového vidění. Stavíme praktické produkty pro retail, veřejnou správu i rodinné oslavy — vyberte si ten svůj.</p>
    </section>

    <section class="product-hub">
      <h2>Naše produkty</h2>
      <div class="product-hub-grid">
        <ProductCard
          href="/footfall/"
          title="Footfall"
          tagline="Přesné počítání návštěvníků a AI analýza návštěvnosti pro prodejny a obchodní centra."
          cta="Zjistit více"
        >
          <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
        </ProductCard>

        <ProductCard
          href="/prodavacka/"
          title="AZ prodavačka"
          tagline="Hlasový AI asistent přímo na prodejně, který poradí zákazníkům a odpoví na jejich dotazy."
          cta="Zjistit více"
        >
          <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 1a3 3 0 0 0-3 3v8a3 3 0 0 0 6 0V4a3 3 0 0 0-3-3z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" y1="19" x2="12" y2="23"/><line x1="8" y1="23" x2="16" y2="23"/></svg>
        </ProductCard>

        <ProductCard
          href="/veciobecni/"
          title="veciobecni.cz"
          tagline="Data z úředních desek obcí na mapě. Nakreslete si vlastní oblast a hlídejte nemovitosti i jednání zastupitelstev ve svém okolí."
          cta="Zjistit více"
        >
          <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"/><circle cx="12" cy="10" r="3"/></svg>
        </ProductCard>

        <ProductCard
          href="/manarozeniny/"
          title="manarozeniny.cz"
          tagline="Narozeninová stránka na vlastní adrese – pozvánka, potvrzení účasti hostů a seznam dárků, ať se neopakují."
          cta="Zjistit více"
        >
          <svg slot="icon" xmlns="http://www.w3.org/2000/svg" width="34" height="34" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 12 20 22 4 22 4 12"/><rect x="2" y="7" width="20" height="5"/><line x1="12" y1="22" x2="12" y2="7"/><path d="M12 7H7.5a2.5 2.5 0 0 1 0-5C11 2 12 7 12 7z"/><path d="M12 7h4.5a2.5 2.5 0 0 0 0-5C13 2 12 7 12 7z"/></svg>
        </ProductCard>
      </div>
    </section>

    <ContactSection heading="Kontakt" />
  </main>

  <footer>
    <p>&copy; {new Date().getFullYear()} AZ Vision. Všechna práva vyhrazena.</p>
    <p>Praha, Česká republika</p>
  </footer>
</Layout>
