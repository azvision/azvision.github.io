---
interface Props {
  lang?: string;
}
const { lang = "cs" } = Astro.props as Props;
---

<section class="features advanced-features">
  <h2>
    {lang === "en" ? "Advanced features" : "Pokročilé funkce"}
  </h2>

  <div class="advanced-feature-item">
    <h3 class="advanced-feature-title">
      {lang === "en" ? "Group detection" : "Detekce skupin"}
    </h3>
    <div class="feature-image-item">
      <div class="image-container">
        <img
          src="/group-detection.jpg"
          alt={lang === "en"
            ? "Two people linked as one group by AZ Vision detection"
            : "Dva lidé propojení do jedné skupiny detekcí AZ Vision"}
          loading="lazy"
        />
      </div>
    </div>
    <p class="feature-image-caption">
      {
        lang === "en"
          ? "AZ Vision recognises when people arrive together — a couple, a family or a group of friends. Instead of anonymous headcounts you see how many real shopping parties walk in — a sharper read on sales potential and customer behaviour."
          : "AZ Vision rozpozná, když lidé přicházejí společně — pár, rodinu nebo skupinu přátel. Místo anonymních čísel tak víte, kolik k vám míří skutečných nákupních skupin, a lépe odhadnete potenciál tržeb i chování zákazníků."
      }
    </p>
  </div>

  <div class="advanced-feature-item">
    <h3 class="advanced-feature-title">
      {lang === "en" ? "Heatmaps" : "Heatmapy"}
    </h3>
    <div class="feature-image-item">
      <div class="image-container">
        <img
          src="/heatmap.jpg"
          alt={lang === "en"
            ? "Heatmap overlay showing where customers spend the most time"
            : "Heatmapa ukazující, kde se zákazníci nejvíce zdržují"}
          loading="lazy"
        />
      </div>
    </div>
    <p class="feature-image-caption">
      {
        lang === "en"
          ? "The heatmap reveals where customers spend the most time in your store. Spot your hottest zones and overlooked corners at a glance — then place products, promotions and signage where they actually sell."
          : "Heatmapa ukazuje, kde se zákazníci v prodejně nejvíce zdržují. Na první pohled odhalíte nejsilnější i přehlížená místa — a podle toho rozmístíte zboží, akce a navigaci tak, aby skutečně prodávaly."
      }
    </p>
  </div>

  <div class="advanced-feature-item">
    <h3 class="advanced-feature-title">
      {lang === "en" ? "Wide entrances" : "Široké vchody"}
    </h3>
    <div class="feature-image-item">
      <div class="image-container">
        <img
          src="/multi-camera-dedup.png"
          alt={lang === "en"
            ? "Two cameras covering one wide entrance, counting each visitor once"
            : "Dvě kamery pokrývají jeden široký vchod a počítají každého návštěvníka jednou"}
          loading="lazy"
        />
      </div>
    </div>
    <p class="feature-image-caption">
      {
        lang === "en"
          ? "One camera not enough for a wide entrance or lobby? Combine several — they talk to each other and reconcile the overlapping view, so every visitor is counted exactly once, never twice. Accurate footfall even across the widest doors."
          : "Nestačí jedna kamera na široký vchod nebo halu? Zapojte jich víc — vzájemně si povídají a vyřeší překrývající se záběr, takže se každý návštěvník započítá přesně jednou, nikdy dvakrát. Přesné počítání i u nejširších dveří."
      }
    </p>
  </div>

  <div class="advanced-feature-item">
    <h3 class="advanced-feature-title">
      {lang === "en" ? "HD recording" : "HD nahrávání"}
    </h3>
    <div class="feature-image-item">
      <div class="image-container">
        <img
          src="/hd-video.jpg"
          alt={lang === "en"
            ? "Full 1080p HD footage recorded straight from the camera"
            : "Plné 1080p HD video nahrané přímo z kamery"}
          loading="lazy"
        />
      </div>
    </div>
    <p class="feature-image-caption">
      {
        lang === "en"
          ? "Need security‑grade footage, not just counts? Switch any camera to full 1080p HD recording straight from its hardware encoder — sharp, identifiable video with no loss of counting accuracy and no dropped frames. Clips upload automatically, ready to review any moment."
          : "Potřebujete i kvalitní bezpečnostní záznam, ne jen čísla? Přepněte kameru na plné 1080p HD nahrávání přímo z hardwarového enkodéru — ostré, čitelné video bez ztráty přesnosti počítání a bez zahazování snímků. Klipy se nahrávají automaticky a kdykoli se k nim vrátíte."
      }
    </p>
  </div>

  <div class="advanced-feature-item">
    <h3 class="advanced-feature-title">
      {lang === "en" ? "Camera monitoring" : "Hlídání kamery"}
    </h3>
    <div class="feature-image-item">
      <div class="image-container">
        <img
          src="/camera-orientation.png"
          alt={lang === "en"
            ? "AZ Vision detects when a camera has been moved or tilted and alerts you"
            : "AZ Vision pozná, když se kamera pohne nebo nakloní, a upozorní vás"}
          loading="lazy"
        />
      </div>
    </div>
    <p class="feature-image-caption">
      {
        lang === "en"
          ? "A knocked, rotated or sagging camera quietly ruins your data. AZ Vision continuously watches each camera's orientation and alerts you the moment it moves — so with an early warning and a quick visual check, you set it right before your counts drift."
          : "Nakloněná, pootočená nebo povolená kamera potichu zkazí data. AZ Vision proto průběžně hlídá orientaci každé kamery a upozorní hned, jak se pohne — díky včasné detekci a obrazové kontrole tak vše napravíte dřív, než se počty zkreslí."
      }
    </p>
  </div>
</section>
